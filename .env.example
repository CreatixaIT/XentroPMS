# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
# SUPABASE_SERVICE_ROLE_KEY is recommended for auth.admin operations due to SDK compatibility
# See: https://github.com/supabase/supabase-js/issues/1568
# The new secret key format (sb_secret_) has compatibility issues with auth.admin APIs
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Super Admin Initialization (for initial setup only)
# Run: npm run init-admin
INITIAL_ADMIN_EMAIL=xentroevent@gmail.com
INITIAL_ADMIN_PASSWORD=your_secure_password_here
